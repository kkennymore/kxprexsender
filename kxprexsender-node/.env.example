# Server Configuration
NODE_ENV=development
PORT=3000

# Firebase Cloud Messaging
# Get these from Firebase Console > Project Settings > Service Accounts
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# IMPORTANT: Use $$ for newlines in .env files
# Example:
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
FCM_PRIVATE_KEY=

# Web Push (VAPID)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com

# Backend URL (for CORS and redirects)
BACKEND_URL=http://localhost:3000

# Database
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kxprexsender

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379

# JWT Secret (for authentication)
JWT_SECRET=your-jwt-secret-key

# Logging
LOG_LEVEL=info
