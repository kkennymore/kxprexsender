{
  "name": "kxprexsender",
  "version": "2.0.0",
  "description": "Production-ready notification sender with caching, rate limiting, metrics, and template support",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "cli": "ts-node src/cli/index.ts"
  },
  "keywords": [
    "notifications",
    "push",
    "fcm",
    "webpush",
    "socket",
    "cache",
    "rate-limit",
    "metrics"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "express": "^4.18.0",
    "ioredis": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.0.0",
    "rate-limiter-flexible": "^4.0.0",
    "socket.io": "^4.7.0",
    "uuid": "^9.0.0",
    "web-push": "^3.6.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@types/web-push": "^3.6.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
