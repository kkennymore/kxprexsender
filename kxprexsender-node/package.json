{
  "name": "kxprexsender",
  "version": "1.0.0",
  "description": "Backend notification sender/router for kxprexsender - supports Web Push, FCM, and Socket",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "notifications",
    "push",
    "fcm",
    "webpush",
    "socket"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "jsonwebtoken": "^9.0.2",
    "socket.io": "^4.7.0",
    "web-push": "^3.6.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/web-push": "^3.6.0",
    "typescript": "^5.0.0"
  }
}
